# Copy to .env and change the passwords. Never commit .env.
# These are LOCAL DEV values only. In AWS, secrets come from SSM Parameter Store.

# Postgres superuser (used only by the init scripts and for admin work)
POSTGRES_ADMIN_USER=cardflow_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin
POSTGRES_PORT=5432

# One login per service; each can only connect to its own database
LEDGER_DB_PASSWORD=change-me-ledger
AUTHORIZATION_DB_PASSWORD=change-me-authorization
ASSISTANT_DB_PASSWORD=change-me-assistant

# Services
LEDGER_PORT=8081
AUTHORIZATION_PORT=8082

# Kafka
KAFKA_PORT=9092
